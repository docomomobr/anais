{
  "id": "{{ .Params.slug }}",
  "type": "paper-conference",
  "title": {{ printf "%s%s" .Title (cond (ne (.Params.subtitle | default "") "") (printf ": %s" .Params.subtitle) "") | jsonify }},
  "container-title": {{ .Params.event_title | jsonify }},
  "event-title": {{ .Params.event_title | jsonify }},
  {{- with .Params.event_location }}
  "event-place": "{{ . }}",
  "publisher-place": "{{ . }}",
  {{- end }}
  "issued": { "date-parts": [[{{ dateFormat "2006" .Date }}, {{ dateFormat "1" .Date }}, {{ dateFormat "2" .Date }}]] },
  {{- with .Params.doi }}
  "DOI": "{{ . }}",
  {{- end }}
  {{- with .Params.event_isbn }}
  "ISBN": "{{ . }}",
  {{- end }}
  {{- with .Params.pages }}
  "page": "{{ . }}",
  {{- end }}
  {{- with .Params.zenodo_pdf_url }}
  "URL": "{{ . }}",
  {{- end }}
  "language": "{{ .Params.locale | default "pt-BR" }}",
  {{- with .Params.abstract }}
  "abstract": {{ . | jsonify }},
  {{- end }}
  {{- with .Params.keywords }}
  "keyword": {{ delimit . ", " | jsonify }},
  {{- end }}
  "author": [
    {{- range $i, $au := .Params.authors }}{{ if $i }},{{ end }}
    { "family": {{ $au.familyname | jsonify }}, "given": {{ $au.givenname | jsonify }}{{ with $au.orcid }}, "ORCID": "https://orcid.org/{{ . }}"{{ end }} }
    {{- end }}
  ]
}
