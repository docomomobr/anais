  author    = {Sakurai, Tatiana and Brito, Gisele Ferreira de and Uliana, Dina Elisabete and Marques, Eliana de Azevedo},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
