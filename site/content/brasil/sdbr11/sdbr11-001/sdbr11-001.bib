@inproceedings{sdbr11_001,
  title     = {A identidade brasileira na estamparia de tecidos para interiores: a "Larmod" na década de 1970},
  author    = {Lima, Ricardo Ferreira de Oliveira and Sakurai, Tatiana},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
  pages     = {1-13},
  doi       = {10.5281/zenodo.19074456},
  isbn      = {978-85-415-0803-2},
  url       = {https://zenodo.org/records/19074457/files/sdbr11-001.pdf},
  abstract  = {A expressão visual de uma identidade nacional ocorreu tardiamente na produção industrial de tecidos para interiores no Brasil. A moda foi uso de motivos brasileiros já na década de 1950, a produção dedicada à arquitetura de interiores, no entanto, somente se libertou da mera reprodução de motivos estrangeiros vinte anos depois, na década de 1970. Este artigo propõe-se apresentar o levantamento que aponta o pioneirismo do estúdio paulistano Larmod no desenvolvimento e utilização de motivos brasileiros em tecidos estampados em escala industrial para interiores. O levantamento inclui: revisão bibliográfica, consulta a publicações de época e entrevistas semi-estruturadas com as personagens centrais desse processo. O levantamento indicou outros nomes, em períodos até anteriores; estes privilegiaram, entretanto, a produção em escala pequena, artesanal e experimental de design gráfico para superfícies têxteis. Este artigo é resultado de um projeto de Iniciação Científica em desenvolvimento pelo autor e sua orientadora.},
  keywords  = {Superfície têxtil, Interiores, Estamparia, Larmod, Brasil},
}
