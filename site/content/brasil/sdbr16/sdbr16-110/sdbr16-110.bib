  title     = {La Ciudad Universitaria de Madrid: proyecto, memoria y transformación},
  author    = {Esteban Maluenda, Ana and Mariné Carretero, Nicolás},
  booktitle = {16º Seminário Docomomo Brasil, Porto Alegre, 2025},
  year      = {2025},
