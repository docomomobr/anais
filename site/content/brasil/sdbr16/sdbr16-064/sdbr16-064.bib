  title     = {Planos de conservação e manutenção para o Patrimônio Arquitetônico hospitalar moderno: estratégias e desafios},
  author    = {Freitas, Pedro Murilo Gonçalves de and Guimarães, Marta Cristina Ferreira Buarque},
  booktitle = {16º Seminário Docomomo Brasil, Porto Alegre, 2025},
