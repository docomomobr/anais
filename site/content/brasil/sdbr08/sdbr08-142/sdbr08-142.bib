@inproceedings{sdbr08_142,
  title     = {Passeio de Copacabana: uma referência da arte pública de Roberto Burle Marx},
  author    = {Floriano, Cesar},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19073279},
  isbn      = {978-85-88027-11-4},
  url       = {https://zenodo.org/records/19073280/files/sdbr08-142.pdf},
  abstract  = {O artigo enfoca o paisagismo de Roberto Burle Marx pelo viés de sua relação com as artes plásticas. Partindo de passagens de textos de Burle Marx, em que ele reivindica a condição artística de seus jardins, chega-se a formular a hipótese de que estes, antes de representarem uma "síntese das artes", isto é, a fusão harmoniosa entre paisagismo, arquitetura e artes plásticas, cerne da utopia do Movimento Moderno, contêm uma relação dialética entre estas diferentes manifestações artísticas. Tal condição, ao expressar contradições, é, portanto, mais consentânea ao seu contexto – o Brasil dos anos 1940-70, quando a síntese das artes era proclamada pelos seguidores do Movimento Moderno – que a utopia original. Para tanto, são discutidas as relações entre a pintura e o paisagismo na obra de Burle Marx, e apresentadas reflexões sobre a noção de "síntese das artes", inclusive as formuladas pelo próprio Burle Marx.},
  keywords  = {Burle Marx, Arte Pública, Paisagismo},
}
