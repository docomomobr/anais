  title     = {Edifício do IPASE, em Natal/RN: o mais moderno da cidade, em 1955},
  author    = {Pereira, Marizo Vitor and Nobre, Paulo José Lisboa and Furukava, Camila and Oliveira, Aquiles Alberto Ramos de Pina},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
