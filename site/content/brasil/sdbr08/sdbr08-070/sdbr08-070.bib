@inproceedings{sdbr08_070,
  title     = {Caminhos da arquitetura moderna em Fortaleza: a contribuição do paisagista Roberto Burle Marx},
  author    = {Paiva, Ricardo Alexandre and Diógenes, Beatriz Helena Bezerra Nogueira},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-13},
  doi       = {10.5281/zenodo.19073019},
  isbn      = {978-85-88027-11-4},
  url       = {https://zenodo.org/records/19096159/files/sdbr08-070.pdf},
  abstract  = {Apresentar os caminhos da arquitetura moderna em Fortaleza, contextualizando-a com as principais transformações urbanísticas ocorridas na cidade, é o objetivo deste trabalho. Mediante os conflitos inerentes ao processo de modernização de Fortaleza e os desdobramentos das relações entre o moderno e a tradição, a emergência do arranha-céu, com suas interfaces com as novas técnicas e materiais de construção, é revelada como uma síntese dos paradoxos que engendraram a produção da arquitetura moderna e contemporânea na cidade. Mais do que reforçar binarismos, o trabalho pretende elucidar as relações entre a modernidade e a tradição como um embate dialético que transcende a história da arquitetura e da cidade e repercute na própria arte.},
  keywords  = {arquitetura e paisagismo moderno, Roberto Burle Marx, Fortaleza},
}
