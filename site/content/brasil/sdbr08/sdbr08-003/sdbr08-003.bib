  title     = {Cidade nova: síntese das artes interlocuções com a fotografia moderna e de vanguarda},
  author    = {Videsott, Luisa},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-16},
