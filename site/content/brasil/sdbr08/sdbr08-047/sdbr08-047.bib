  title     = {Cartas da América: arquitetura e Modernidade},
  author    = {Falbel, Anat},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-15},
