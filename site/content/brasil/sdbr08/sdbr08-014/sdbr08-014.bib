  title     = {Aproximações, diferenciações e embates entre a produção do Rio de Janeiro e de São Paulo nas revistas de arquitetura (1945-1960)},
  author    = {Dedecca, Paula Gorenstein},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-18},
