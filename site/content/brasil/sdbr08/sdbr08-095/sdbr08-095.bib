  title     = {Nikolaus Pevsner: o artífice do Movimento Moderno enquanto objeto historiográfico},
  author    = {Paoli, Paula Silveira de},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-18},
