  title     = {Comunicação, diversão e oração: os espaços do Art Déco e o Patrimônio Moderno de Caruaru-PE},
  author    = {Silva, Aline de Figueirôa},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
