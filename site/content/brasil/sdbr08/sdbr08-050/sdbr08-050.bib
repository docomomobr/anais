@inproceedings{sdbr08_050,
  title     = {Avenida Amaral Peixoto: o Modernismo e o colonial na abertura de uma via monumental},
  author    = {Krykhtine, Carlos Alberto Peres},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-15},
