@inproceedings{sdbr02_023,
  title     = {Modernidade e Tradição: o projeto da Malagueira em Évora, Portugal},
  author    = {Zapatel, Juan Antonio},
  booktitle = {Novas formulações no campo da Arquitetura e Urbanismo},
  year      = {1997},
  address   = {Salvador},
  pages     = {230-237},
  doi       = {10.5281/zenodo.19070426},
  isbn      = {978-85-509-0555-6},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr02/sdbr02-023/},
  abstract  = {Este artigo apresenta um estudo do projeto habitacional da Malagueira, do arquiteto Álvaro Siza Vieira, para a periferia da cidade de Évora, em Portugal. O projeto e o início da construção datam de 1977. Atualmente, a maior parte das unidades estão concluídas, representando em termos europeus uma das maiores obras recentes no campo da habitação social. Sob uma análise da prática contemporânea do projeto urbano, vinculada tanto a cultura arquitetônica moderna como a local, reconhece-se através deste trabalho, um dos caminhos da arquitetura habitacional para a construção da cidade contemporânea.},
}
