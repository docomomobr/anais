  title     = {O caráter de três casas modernistas na av. Washington Luiz em Presidente Prudente-SP},
  author    = {Hirao, Hélio and Yamaki, Humberto and Lamounier, Alex and Fiorin, Evandro and Bernal, Luciana},
  booktitle = {Interdisciplinaridade e experiências de documentação e preservação do patrimônio recente},
  year      = {2011},
