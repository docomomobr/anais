  title     = {A experiência de conservação do Iate Tênis Clube da Pampulha como indicador da importância da abordagem contextual},
  author    = {Carsalade, Flávio de Lemos and Castro, Maria Angela Reis de},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
  pages     = {1-10},
