  title     = {Digitalização do arquivo de projeto da Construtora Medaglia e o levantamento da arquitetura dos anos trinta e quarenta no interior do Rio Grande do Sul},
  author    = {Kerber, Rodrigo Fabrício},
  booktitle = {Interdisciplinaridade e experiências de documentação e preservação do patrimônio recente},
  year      = {2011},
