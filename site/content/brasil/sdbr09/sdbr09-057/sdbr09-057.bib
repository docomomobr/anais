  title     = {Montbau, 1959: reflexões sobre a preservação de intervenções habitacionais de interesse social modernas},
  author    = {Melo, Alcília Afonso de Albuquerque e},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
  pages     = {1-13},
  doi       = {10.5281/zenodo.19073727},
