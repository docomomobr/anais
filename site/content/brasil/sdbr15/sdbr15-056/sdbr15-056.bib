  title     = {De sala de espera dos mortos a obituário moderno: Pavilhão Luiz Nunes},
  author    = {Gáti, Andréa},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-14},
