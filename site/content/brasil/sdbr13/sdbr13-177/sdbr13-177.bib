@inproceedings{sdbr13_177,
  title     = {Desdobramentos vitruvianos nas obras de Le Corbusier: princípios e procedimentos de projeto},
  author    = {Arruda, Beatriz Schmidt and Manenti, Leandro},
  booktitle = {Arquitetura moderna brasileira: 25 anos do Docomomo Brasil: todos os mundos, um só mundo},
  year      = {2019},
  address   = {Salvador},
  pages     = {1},
  doi       = {10.5281/zenodo.19077879},
  isbn      = {978-85-66843-06-4},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr13/sdbr13-177/},
  abstract  = {O presente trabalho se insere na pesquisa Arquiteturas escritas: Investigações acerca dos princípios e procedimentos de projeto a partir de textos de autores arquitetos. Após os estudos sobre a produção de Vitruvius e de Alberti, o trabalho se debruça sobre as publicações de Le Corbusier, com ênfase em Por uma Arquitetura, Precisões e O Modulor I e II. A análise desses escritos busca os princípios de qualidade de uma obra arquitetônica e os procedimentos necessários para alcançá-los. Tem como objetivo procurar os caminhos para as decisões tomadas durante o processo de projeto e verificar os possíveis desdobramentos da teoria vitruviana.},
}
