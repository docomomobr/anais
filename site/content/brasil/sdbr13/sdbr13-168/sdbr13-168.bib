  author    = {Cunha, Marcio Cotrim and Lara, Fernando Luiz Camargos and Guerra, Abilio},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1-24},
