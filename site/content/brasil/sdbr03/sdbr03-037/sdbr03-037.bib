  title     = {Sobre miscigenação, falta de tradição e orquídeas: a nacionalização da Arquitetura Moderna Brasileira nas revistas de arquitetura de língua alemã},
  author    = {Campos, Márcio Correia},
  booktitle = {3º Seminário Docomomo Brasil, São Paulo, 1999},
