@inproceedings{sdbr03_049,
  title     = {Edifício Esther: impactos dolosos de seu tombamento},
  author    = {Atique, Fernando},
  booktitle = {A permanência do moderno},
  year      = {1999},
  address   = {São Paulo},
  pages     = {1-9},
  doi       = {10.5281/zenodo.19070665},
  isbn      = {85-85205-56-3},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr03/sdbr03-049/},
  abstract  = {Este artigo trata do panorama da preservação do patrimônio arquitetônico moderno nacional, tendo como objeto de reflexão o Edifício Esther, localizado na Praça da República, em São Paulo. Uma das primeiras manifestações de Arquitetura Moderna no país, este edifício vem sendo alvo de ações governamentais no sentido de sua conservação e preservação. Tais ações, entretanto, revelam-se contraditórias na medida em que conservam algumas descaracterizações sofridas pelo edifício desde os anos 70, e, também, por não contar com a adesão de seus proprietários e usuários neste processo.},
}
