  title     = {O CODEPAC e a luta pela preservação de edifícios modernos em Bauru – SP},
  author    = {Ghirardello, Nilson},
  booktitle = {3º Seminário Docomomo Brasil, São Paulo, 1999},
  year      = {1999},
