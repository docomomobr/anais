@inproceedings{sdbr06_055,
  title     = {Modernismo e urbanidade: os pioneiros da moradia vertical em São Paulo},
  author    = {Galesi, René and Campos Neto, Candido Malta},
  booktitle = {Moderno e nacional, Arquitetura e Urbanismo},
  year      = {2005},
  address   = {Niterói},
  doi       = {10.5281/zenodo.19072512},
  isbn      = {85-99618-01-6},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr06/sdbr06-055/},
  abstract  = {Este trabalho enfoca os primórdios da verticalização residencial na cidade de São Paulo, destacando a introdução dos princípios modernos de moradia vertical e o papel de alguns arquitetos modernistas em sua afirmação. No momento em que se defrontavam diferentes visões a respeito do adensamento urbano e dos arranha-céus, e surgiam também os marcos legislativos que balizariam a construção de prédios, a arquitetura racionalista permitiu conciliar o aproveitamento intensivo do solo e a provisão de espaços de qualidade, trazendo uma estética coerente com as aspirações de modernidade urbana, industrial e metropolitana que legitimavam o recurso à moradia em altura. Nesse quadro destaca-se, já na década de 1930, as realizações pioneiras de Rino Levi (Edifício Columbus) e Álvaro Vital Brazil (Edifício Esther).},
  keywords  = {arquitetura, modernismo, edifícios residenciais},
}
