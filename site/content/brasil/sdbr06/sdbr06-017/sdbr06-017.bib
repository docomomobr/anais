  title     = {Influências estrangeiras e afirmação nacional no espaço urbano do Rio de Janeiro, 1922/1940},
  author    = {Siqueira, Eduardo Cezar},
  booktitle = {6º Seminário Docomomo Brasil, Niterói, 2005},
