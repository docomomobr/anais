@inproceedings{sdbr06_009,
  title     = {Análise arquitetônica de uma residência moderna na cidade de João Pessoa/PB},
  author    = {Costa, Carolina and Lima, Raoni},
  booktitle = {6º Seminário Docomomo Brasil, Niterói, 2005},
  year      = {2005},
  address   = {Niterói},
  doi       = {10.5281/zenodo.19072334},
  isbn      = {85-99618-01-6},
  url       = {https://zenodo.org/records/19072335/files/sdbr06-009.pdf},
  abstract  = {Este artigo tem o objetivo de analisar a arquitetura de uma residência moderna, construída no ano de 1968, com projeto de Acácio Gil Borsói, na cidade de João Pessoa/PB. Primeiramente, é realizada a contextualização do objeto no processo de desenvolvimento da cidade. Em seguida, são analisados separadamente a implantação, composição volumétrica e organização espacial, a fim de investigar a função que cada parte cumpre, isolada e em conjunto com as demais. Ao longo do trabalho, são identificadas as características que prestam referência às propostas modernistas e é verificado sobre que aspectos as críticas à arquitetura moderna se aplicam.},
  keywords  = {Arquitetura, Moderna},
}
