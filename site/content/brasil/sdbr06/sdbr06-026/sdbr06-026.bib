@inproceedings{sdbr06_026,
  title     = {Ensinando a morar: a busca pelo homem novo através da arquitetura no conjunto do Pedregulho},
  author    = {Silva, Helga Santos da and Santos, Mauro Cesar de Oliveira},
  booktitle = {Moderno e nacional, Arquitetura e Urbanismo},
  year      = {2005},
  address   = {Niterói},
  doi       = {10.5281/zenodo.19072404},
  isbn      = {85-99618-01-6},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr06/sdbr06-026/},
  abstract  = {Este trabalho se refere à proposta de transformação social, através da arquitetura e urbanismo, presente no discurso dos arquitetos modernos, principalmente dos expoentes da Corrente Funcionalista, ou Racionalista. O estudo de caso, o objeto de análise é o do Conjunto Residencial Prefeito Mendes de Moraes, ou Pedregulho. Para tanto, essa leitura é aqui apresentada a partir das duas formas eleitas pelos idealizadores do projeto do Conjunto para a realização da dita transformação: o projeto arquitetônico e o estabelecimento de normas para habitá-lo. Para complementar, apresentase também a opinião dos moradores. Assim, pode-se discutir, a respeito de uma obra realizada, a intenção de construir o novo homem da era da máquina, tendo como pano de fundo a política propagandista da Era Vargas; a concepção dos Idealizadores do projeto do Conjunto, Affonso Eduardo Reidy e Carmen Portinho; bem como a opinião dos que efetivamente foram alvo dessa intenção: os moradores.},
  keywords  = {Arquitetura Moderna, Habitação Popular},
}
