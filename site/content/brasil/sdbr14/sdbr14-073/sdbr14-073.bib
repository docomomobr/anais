  title     = {Resultado das lições aprendidas: arquitetura multifamiliar residencial moderna na Fortaleza dos anos de 1970},
  author    = {Andrade, Margarida Júlia Farias de Salles and Duarte Junior, Romeu and Jucá Neto, Clóvis Ramiro},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
