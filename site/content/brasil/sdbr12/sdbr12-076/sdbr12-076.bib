  title     = {Edifícios modernos em ruínas até quando?},
  author    = {Pflueger, Grete Soares and Pereira, Victória Batista},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
  address   = {Uberlândia},
