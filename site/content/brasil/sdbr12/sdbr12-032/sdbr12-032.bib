  author    = {Neves, Priscila Pires Corrêa and Laurentiz, Luiz Carlos de},
  booktitle = {Arquitetura e Urbanismo do Movimento Moderno: patrimônio cultural brasileiro: difusão, preservação e sociedade},
  year      = {2017},
