@inproceedings{sdbr12_057,
  title     = {A Casa do Brasil em Madri},
  author    = {Rocha, Ricardo de Souza},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
  address   = {Uberlândia},
