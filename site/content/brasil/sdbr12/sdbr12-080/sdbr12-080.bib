  title     = {Deriva como Educação Patrimonial: imagens de modernidade},
  author    = {Ferreira, Bráulio Vinícius and Oliveira, Simone Borges Camargo de},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
  address   = {Uberlândia},
  doi       = {10.5281/zenodo.19077236},
