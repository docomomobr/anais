  title     = {Origens do percurso moderno em Diamantina},
  author    = {Frajndlich, Rafael Urano},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
  address   = {Uberlândia},
