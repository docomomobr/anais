@inproceedings{sdbr04_044,
  title     = {A Casa São Luiz para a Velhice, 1935},
  author    = {Cerávolo, Ana Lúcia},
  booktitle = {4º Seminário Docomomo Brasil, Viçosa, 2001},
  year      = {2001},
  address   = {Viçosa},
  pages     = {1-2},
  abstract  = {O trabalho proposto é parte da dissertação de mestrado Paulo de Camargo e Almeida. Arquitetura Total na trajetória de um arquiteto brasileiro, realizada com o apoio da FAPESP. O arquiteto Paulo de Camargo dedicou toda sua vida profissional à pesquisa no campo das industrialização das construções, tanto no âmbito da prática construtiva, como no desenvolvimento de pesquisas acadêmicas. Nos anos 60, foi responsável pelas experiências desenvolvidas pelo Fundo de Construções da Universidade de São Paulo (FUNDUSP), que culminou com a construção do alojamento de estudantes no campus de São Paulo, conhecido como CRUSP, projetado por Eduardo Kneese de Mello, num dos mais interessantes exemplos com sistemas construtivos industrializados realizados no país. Pretendemos abordar, nesse trabalho, um dos mais relevantes projetos construídos de Paulo de Camargo, a Casa São Luiz, ou Asilo São Luiz como era conhecido à época, como uma das primeiras obra da arquitetura moderna brasileira a utilizar o conceito de industrialização e racionalização das construções. Na Casa São Luiz, 1935, tanto o sentido experimental, como seu caráter precursor são inegáveis. Nela são desenvolvidas e utilizadas soluções construtivas inovadoras, algumas inéditas no país até aquele momento. O cálculo do sistema estrutural em concreto armado, totalmente modulado, foi responsabilidade do engenheiro Nathan Feferman. Vários componentes dessa obra foram confeccionados fora do canteiro e trazidos no momento da montagem, como as placas para o isolamento térmico da cobertura, as paredes divisórias de “celotex”, as esquadrias de concreto, etc. Outro aspecto a destacar são as caixas de concreto que protegem as janelas do sol. O resultado formal, bastante interessante, constitui uma força expressiva da fachada externa da Casa, além de funcionar como “brise-solail”, elemento construtivo extremamente explorado pelos arquitetos brasileiros e que se configurou como uma das marcas da arquitetura moderna realizada no país. Pretendemos ainda contextualizar o desenvolvimento da sua pesquisa, localizando o seu projeto de industrialização, no âmbito do debate sobre “economia das construções”, tema central para vários de seus contemporâneos, como Gregori Warchavchik, Flávio de Carvalho, Rino Levi, Lúcio Costa, Affonso Eduardo Reidy, Luís Nunes e Attílio Correa Lima, no período de introdução da arquitetura moderna no Brasil.},
}
