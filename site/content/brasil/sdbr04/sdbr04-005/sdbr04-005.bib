@inproceedings{sdbr04_005,
  title     = {A arquitetura moderna em São Paulo e o diálogo com o Concretismo},
  author    = {Fernandes, Fernanda},
  booktitle = {4º Seminário Docomomo Brasil, Viçosa, 2001},
  year      = {2001},
  address   = {Viçosa},
  pages     = {1-2},
  abstract  = {A cidade de São Paulo nos anos 50 vive o seu segundo processo de industrialização, que impulsiona o crescimento urbano com significativa verticalização das áreas centrais. No campo cultural a cidade ganha novas instituições como os museus MASP e MAM e também as Bienais Internacionais, que funcionam como centros propulsores de debates e reflexões sobre as artes e a arquitetura. Em 1952 um grupo de artistas plásticos liderados por Waldemar Cordeiro irá criar o movimento Ruptura, representando a afirmação das tendências construtivas em São Paulo e estabelecendo novos parâmetros de análise sobre as relações entre arte e indústria. Simpatizante das propostas da Bauhaus, Cordeiro irá propor a atuação do artista inserido no ambiente da vida, próximo ao desenho industrial e dialogando com a padronização solicitada pelos processos de industrialização. Também Lygia Clark em seus textos e obras irá indicar alguns aspectos a serem explorados no diálogo arte arquitetura, a partir da lógica construtiva, e dos elementos padronizados da indústria da construção. A presença de Max Bill em São Paulo, premiado na I Bienal e com grande exposição no MASP, irá reforçar o debate entre as tendências construtivas pautadas por rigoroso racionalismo e a produção arquitetônica brasileira realizada até este momento, principalmente pelo grupo carioca. É intenção desse trabalho observar até que ponto estes debates contribuíram efetivamente para novas propostas arquitetônicas realizadas a partir desse momento. Para tanto nos deteremos nas propostas teóricas e na análise de algumas obras onde pode-se verificar desdobramentos destas posturas. Ainda pouco analisado, este aspecto de nossa cultura arquitetônica pode contribuir para a compreensão das transformações que ocorrem nas décadas de 50 e 60, na produção arquitetônica brasileira e particularmente na de São Paulo.},
}
