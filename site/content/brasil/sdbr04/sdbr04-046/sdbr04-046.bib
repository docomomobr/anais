@inproceedings{sdbr04_046,
  title     = {O Instituto de Pesquisas Tecnológicas de São Paulo e a moderna construção em concreto},
  author    = {Caira Gitahy, Maria Lúcia},
  booktitle = {4º Seminário Docomomo Brasil, Viçosa, 2001},
  year      = {2001},
  address   = {Viçosa},
  pages     = {1-2},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr04/sdbr04-046/},
  abstract  = {Esta apresentação traz resultados de pesquisa histórica focalizando a atuação do IPT de São Paulo, específicamente no campo da pesquisa tecnológica e do apoio técnico à construção em concreto no período indicado. Buscou-se investigar uma área de atuação desta instituição em particular, o concreto, voltando a atenção ao apoio técnico prestado às empresas e aos esforços realizados para a normalização e a standartização de materiais e métodos. Dois problemas serão explorados: Como desenvolveu-se a relação entre o IPT e o setor produtivo? Quais as relações entre a pesquisa tecnológica feita aqui e aquela realizada no exterior? Há que observar também as mudanças históricas de São Paulo no período em questão, comprrendendo como o IPT enfrentou os desafios colocados pela verticalização da cidade, na qual a tecnologia do concreto desempenhou relevante papel. Por fim, é preciso enfatizar que este material construtivo transformou-se em linguagem da arquitetura moderna.},
}
