@inproceedings{sdbr04_047,
  title     = {A incorporação do brise-soleil à arquitetura brasileira},
  author    = {Vieira Maragno, Gogliardo},
  booktitle = {4º Seminário Docomomo Brasil, Viçosa, 2001},
  year      = {2001},
  address   = {Viçosa},
  pages     = {1-2},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr04/sdbr04-047/},
  abstract  = {Este artigo pretende analisar a incorporação do brise-soleil ao repertório da arquitetura brasileira. Ao se considerar o desenvolvimento de características próprias na linguagem da arquitetura moderna no Brasil, há que se destacar o papel desempenhado pelo brise-soleil nesse processo. Elemento desenvolvido por Le Corbusier, primeiramente para o norte da África como resposta à necessidade de proteção solar, incorporou-se imediatamente ao repertório dos arquitetos brasileiros não somente pela natureza de nosso clima tropical, mas, também, por ter encontrado referências similares em diversos elementos da nossa arquitetura tradicional. A utilização de brise-soleil contribuiu significativamente para o caráter próprio atribuído à arquitetura brasileira produzida a partir da década de 30, permitindo que se diferenciasse inicialmente da produzida noutros países. Sua utilização deu-se tanto a partir de elementos moldados nas obras quanto através de elementos pré-fabricados, sendo que a sua incorporação ao repertório dos mais representativos arquitetos brasileiros daquele período está diretamente relacionado à adoção dos princípios corbusianos e da difusão entre eles. A partir de meados da década de 50 percebe-se uma mudança no paradigma através da influência da arquitetura americana de Mies van der Rohe, período que, se por um lado implica em um declínio na presença dos brises como dispositivo de proteção solar, por outro determina que, nas obras em que se faz presente, se afaste do caráter de produto artesanal, representado principalmente pelo cobogó, intensificando o uso de elementos industrializados metálicos.},
}
