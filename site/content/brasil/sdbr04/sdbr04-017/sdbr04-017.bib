@inproceedings{sdbr04_017,
  title     = {O plano do Escritório Saturnino de Brito para Campo Grande-MS em 1938},
  author    = {Arruda, Ângelo Marcos Vieira de},
  booktitle = {A Arquitetura moderna brasileira e os processos regionais de industrialização},
  year      = {2001},
  address   = {Viçosa},
  pages     = {1-2},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr04/sdbr04-017/},
  abstract  = {Em 1937, o então Prefeito de Campo Grande –MT, Advogado Eduardo Olímpio Machado, assumiu a chefia do executivo municipal e em caráter prioritário assumiu solucionar os graves problemas de saneamento básico e abastecimento de água da cidade, já com seus 32 mil habitantes na zona urbana. Recebeu autorização da Câmara Municipal para contratar um Plano de Saneamento e escolheu o famoso escritório Saturnino de Brito, “empresa da mais alta idoneidade e capacidade que planejava serviços idênticos em todo o Brasil”. O Plano foi elaborado em 1938 e a Câmara municipal autorizou a contratação de empréstimo junto a Caixa Econômica para a execução das obras. Junto com o Plano de Saneamento, o escritório Saturnino de Brito elaborou, também, um Plano Diretor que em seus 66 artigos, traçava uma política de uso e ocupação do solo, delimitava o zoneamento urbano, determinava as diretrizes para parcelamento do solo e diversas normas para novas construções, que culminou com a aprovação do Decreto-lei n. 39 de 31 de janeiro de 1941. A lei propugnava a divisão da cidade em 5 zonas de uso, caracterizava os tipos de ocupação e dava diretrizes para o ordenamento urbano, tendo vigorado, em seu teor, por mais de 20 anos. Junto com o Plano, o escritório elaborou a primeira Planta Urbana Cadastral planimétrica, um conjunto de mapas urbanos em escalas adequadas, com dados importantes sobre a situação imobiliária da época e algumas diretrizes de expansão urbana. Este Plano resultou de um trabalho profissional de urbanismo, desconhecido da maior parte dos pesquisadores brasileiros e veio consolidar a posição de Campo Grande como principal cidade do oeste nacional, vocacionada para serviços e cujo planejamento proposto, calcado no racionalismo é um legado importante na história do urbanismo moderno brasileiro.},
}
