  title     = {Projeções que fazem refletir sobre o projetar: o restauro da Cinemateca Capitólio},
  author    = {Porto, Camila de Oliveira},
  booktitle = {O moderno e reformado: debatendo o projeto do B. 1920-2022. Parte II},
  year      = {2022},
  address   = {Porto Alegre, RS},
  pages     = {186-197},
