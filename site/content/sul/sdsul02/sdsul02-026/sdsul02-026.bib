  title     = {Niemeyer e Artigas: aproximações e divergências na busca da expressão formal da estrutura},
  author    = {Bahima, Carlos Fernando Silva and Brino, Alex Carvalho},
  booktitle = {2º Seminário Docomomo Sul, Porto Alegre, 2008},
  year      = {2008},
  address   = {Porto Alegre, RS},
