  title     = {Alcyr Meira e a expressão projetual modernista de sua residência em Belém do Pará},
  author    = {Júnior, Edson Silva de Aquino and Nunes, Marcia Cristina Ribeiro Gonçalves and Oliveira, Franciane de Nazaré Sousa},
  booktitle = {Conservar já, Documentar sempre!},
  year      = {2024},
