  title     = {Primeira Igreja Batista de Macapá: análise arquitetônico-compositiva de igreja do período moderno-janarista de Macapá},
  author    = {Barros, Danilo Augusto Oliveira de and Vieira, Flávio Carvalho and Araújo, Lourhan Severino de and Godinho, Emanuella da Silva Piani and Correa Neto, Jacy Soares},
  booktitle = {8º Seminário Docomomo Norte/Nordeste, Palmas, 2021},
  year      = {2021},
