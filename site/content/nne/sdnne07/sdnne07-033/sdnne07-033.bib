@inproceedings{sdnne07_033,
  title     = {Tradição do Nordeste Brasileiro na obra de três arquitetas: Lina Bo Bardi, Janete Costa e Neide Mota Azevedo},
  author    = {Naslavsky, Guilah},
  booktitle = {Tradição nativa, universalidade e conservação},
  year      = {2018},
  address   = {Manaus, AM},
  doi       = {10.5281/zenodo.19294252},
  isbn      = {978-85-526-0057-2},
  url       = {https://anais.docomomobrasil.com/nne/sdnne07/sdnne07-033/},
  abstract  = {Buscando construir uma história da arquitetura na América Latina mais ampla e diversa, Torre (2002) apontou a ausência da contribuição das mulheres no discurso cultural, especialmente aquelas que trazem juntas as culturas indígena, ibero-americana e africana. Muitas trajetórias de mulheres que atuaram no Nordeste e fizeram dessa região seu campo de pesquisa ainda permanecem ausente das historiografias nacionais. Nordeste foi um conceito inventado para explicar a alteridade brasileira (Albuquerque Jr., 2009), foi o local de destino dos modernistas brasileiros, tal como a missão folclórica de Mário de Andra- de (1938). Lina Bo Bardi percebeu a cultura popular do Nordeste como mais oriental do que ocidental (Pereira, 2008), tal como o sociológo Gilberto Freyre usou o Oriente não como Said (1979), mas para explicar a cultura brasileira (Burke and Pallares-Burke, 2008). Cultura vernacular do Nordeste foi a maté- ria prima utilizada por arquitetas que atuaram na região, Janete Costa e Neide Mota de Azevedo. Migra- ções, gênero e regionalismo têm convergido para explicar o trabalho de arquitetas em busca de espaço no campo profissional (Hynen 2013; Lee e Siddiqi, 2018). Aqui discute-se como as arquitetas Lina, Janete e Neide utilizaram a tradição nativa do Nordeste em suas obras modernas.},
  keywords  = {gênero, artesanato, migrações, Nordeste, alteridade},
}
