  title     = {Brilho eterno de uma residência com lembranças: Residência Antônio Ribeiro da Costa em João Pessoa-PB},
  author    = {Morais, Fernando de Oliveira},
  booktitle = {Arquitetura em cidades "sempre novas": modernismo, projeto e patrimônio},
  year      = {2012},
