  title     = {Um estudo de edifícios modernos na cidade de Floriano, Piauí. 1950-1980},
  author    = {Carvalho, Lorena Petrovich Pereira de and Melo, Alcília Afonso de Albuquerque e},
  booktitle = {Arquitetura — tectônica e lugar},
  year      = {2016},
  address   = {Teresina, PI},
