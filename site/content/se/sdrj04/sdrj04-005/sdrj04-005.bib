@inproceedings{sdrj04_005,
  title     = {A magia das imagens: representações do Brasil em Brazil Builds},
  author    = {Herbst, Helio},
  booktitle = {O moderno no Rio: do risco ao risco},
  year      = {2017},
  pages     = {82-97},
  doi       = {10.5281/zenodo.19288357},
  isbn      = {978-85-88027-42-8},
  url       = {https://anais.docomomobrasil.com/se/sdrj04/sdrj04-005/},
  abstract  = {O presente artigo versa sobre os processos de afirmação do Movimento Moderno no Brasil e pretende investigar de que modo o uso da fotografia pode contribuir para a afirmação de conceitos nem sempre explicitados em textos. O objeto de estudo é o seminal livro-catálogo Brazil Builds, editado em 1943 por ocasião da realização de uma exposição homônima no Museu de Arte Moderna de Nova York (MoMA), e tem como suporte teórico as reflexões formuladas por Vilém Flusser em A filosofia da caixa-preta: ensaios para uma futura filosofia da fotografia (1985). Interessa-nos examinar de que modo o referido livro-catálogo incutiu um determinado modo de se pensar a arquitetura moderna brasileira, valendo-se da análise de uma pequena amostra de projetos implantados na cidade do Rio de Janeiro. Por essa seleção de imagens pretende-se equacionar a contribuição da publicação para suprimir o tempo da narrativa, valendo-se do encantamento emanado pela fotografia.},
  keywords  = {fotografia, identidade, arquitetura brasileira},
}
