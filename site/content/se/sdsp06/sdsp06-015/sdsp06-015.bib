  title     = {Lina e Bratke: modos de morar dos arquitetos modernos em São Paulo},
  author    = {Alves, Daniele Aparecida and Regino, Aline Nassaralla},
  booktitle = {a Arquitetura Moderna paulista e a questão social},
  year      = {2018},
  address   = {São Carlos, SP},
  pages     = {242-256},
