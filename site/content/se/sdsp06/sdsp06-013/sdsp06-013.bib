  author    = {Regino, Aline Nassaralla and Perrone, Rafael Antonio Cunha},
  booktitle = {a Arquitetura Moderna paulista e a questão social},
  year      = {2018},
  address   = {São Carlos, SP},
  pages     = {213-227},
