  title     = {Verticalização em São Paulo: novos modos de morar no centro},
  author    = {Fernandes, Marcella França and Regino, Aline Nassaralla},
  booktitle = {6º Seminário Docomomo São Paulo, São Carlos, 2018},
  year      = {2018},
  address   = {São Carlos, SP},
  pages     = {350-366},
