  isbn      = {978-85-66624-25-0},
  url       = {https://anais.docomomobrasil.com/se/sdsp06/sdsp06-022/},
  abstract  = {A dissertação tem como tema principal o processo de verticalização na cidade de São Paulo, com foco no Centro, e seus novos modos de morar que surgiram entre as décadas de 1920 a 1960. O trabalho vai desde São Paulo nos séculos XIX para o século XX - fazendo uma breve contextualização da cidade - explicando como a capital passou de pequeno burgo a grande metrópole, até o processo de verticalização, que foi iniciado na década de 1920, e teve seu auge nas décadas de 1950 a 1960. É mostrado como a verticalização passou por várias fases, percorrendo predominantemente de caráter terciário, e após a aceitação da população, á caráter residencial.},
  keywords  = {Arquitetura Moderna, Morar Vertical, Apartamento},
}
