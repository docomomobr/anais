  title     = {Arquitetura escolar moderna na Baixada Santista: grupo escolar de Pae Cará ou EE. Philomena Cardoso de Oliveira},
  author    = {Silva, Jasmine Luiza Souza Silva and Buzzar, Miguel Antônio},
  booktitle = {Preservar e Valorizar o Patrimônio Arquitetônico Moderno: o papel das instituições públicas e agentes privados},
  year      = {2024},
  address   = {Santos, SP},
  pages     = {94-107},
