  title     = {O patrimônio escolar Art Déco: intervenções na escola Marques de Souza — 1940, São José do Norte/RS},
  author    = {Cabral, Lisiê Kremer and Cordeiro, José Henrique Carlucio and Oliveira, Ana Lúcia Costa de},
  booktitle = {a difusão da Arquitetura Moderna, 1930-1980},
  year      = {2020},
