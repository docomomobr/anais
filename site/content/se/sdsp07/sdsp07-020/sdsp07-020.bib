  author    = {Simabukuro, Julia and Lima, Eduardo Galbes Breda de and Buzzar, Miguel Antônio},
  booktitle = {a difusão da Arquitetura Moderna, 1930-1980},
  year      = {2020},
  address   = {São Paulo, SP},
