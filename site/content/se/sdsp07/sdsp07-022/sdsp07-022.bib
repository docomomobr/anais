  title     = {Estado moderno e produção do espaço pelo Plano de Ação do Estado de São Paulo (1959–1963): a atuação da Secretaria da Agricultura},
  author    = {Aguiar, Gabriel Deller de and Alves, André Augusto de Almeida},
  booktitle = {7º Seminário Docomomo São Paulo, São Paulo, 2020},
  year      = {2020},
  address   = {São Paulo, SP},
  pages     = {279-291},
  doi       = {10.5281/zenodo.19289689},
