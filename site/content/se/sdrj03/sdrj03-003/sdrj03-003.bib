@inproceedings{sdrj03_003,
  title     = {O clássico moderno ou o moderno clássico?: reflexões sobre os edifícios do IRB e do Maison de France},
  author    = {Cabral, Maria Cristina Nascentes and Paraízo, Rodrigo Cury and Nunes, Denise Vianna and Mender, Carolina and Nakano, Diana Ferraz and Almeida, Isabel Lima de and Ferreira, Lígia Daniela Alves and Medeiros, Olívia Vigneron and Costa, Rafael de Oliveira Gomes da},
  booktitle = {A Arquitetura Moderna Fluminense ao tempo de Milton Roberto (1914 — 1953)},
  year      = {2014},
  doi       = {10.5281/zenodo.19288293},
  isbn      = {978-85-88341-63-0},
  url       = {https://anais.docomomobrasil.com/se/sdrj03/sdrj03-003/},
  abstract  = {A arquitetura moderna no Brasil não tem uma produção homogênea que possa ser compreendida como tal. Desde a década de 1990, vem sendo feita revisão historiográfica analisando a diversidade de propostas e leituras sobre a vasta produção no país. A cidade do Rio de Janeiro concentra grande parte dessa produção e autores muito variados. A proposta deste trabalho é cotejar aspectos teóricos, formais e tectônicos de dois importantes edifícios: o Instituto de Resseguros do Brasil (IRB, 1941) e o Maison de France (1951), ambos situados na Esplanada do Castelo, área aterrada com os resíduos da demolição do Morro do Castelo, região que abriga diversas edificações modernas. Procura-se identificar características de composição consideradas clássicas e compreender como são empregadas. Este trabalho foi desenvolvido no Laboratório de Análise Urbana e Representação Digital (LAURD) no Programa de Pós-Graduação em Urbanismo (LAURD/PROURB/UFRJ) com o apoio da FAPERJ e do CNPq.},
}
