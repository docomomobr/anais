@inproceedings{sdnne09_020,
  title     = {O edifício Piedade do Engenheiro Judah Levy em Belém: modernidade, cultura técnica e sociedade},
  author    = {Trindade, João Victor de Alcântara and Chaves, Celma},
  booktitle = {9º Seminário Docomomo Norte/Nordeste, São Luís, 2022},
  year      = {2022},
  address   = {São Luís, MA},
  isbn      = {978-65-00-56400-6},
  organization = {UNDB},
  abstract  = {O processo de verticalização em Belém ocorreu inicialmente na Avenida Presidente Vargas, e foi, sobretudo, tarefa dos engenheiros, que buscaram conjugar nessas novas tipologias arquitetônicas, novas técnicas e materiais, em novas formas de habitar, com a incipiente introdução no circuito imobiliário na cidade. Sob essa perspectiva, o engenheiro Judah Levy projeta o edifício Piedade em 1949, que inaugura uma nova etapa de construções na capital, com novos usos, novos clientes, mas com os desafios apresentados pela arquitetura que se modernizava, e que ainda transitava pelas formas do morar tradicional. O artigo apresenta essa obra, analisando seus aspectos historiográficos e arquitetônicos e contextualizando-a ao cenário local no que se refere à sociedade e à cultura.
},
  keywords  = {modernidade, modernização, verticalização},
}
