  title     = {Arquitetura residencial modernista em São Luís: análise da produção do arquiteto Cleon Furtado},
  author    = {Martins, Marina de Miranda},
  booktitle = {1º Seminário Docomomo Norte/Nordeste, Recife, 2006},
  year      = {2006},
