@inproceedings{sdnne10_060,
  title     = {Os reflexos do moderno: uma análise da mobilidade urbana na escala de vizinhança de Palmas — TO},
  author    = {Machado, Larissa Lopes da Mata and Zenkner, Thaís Trovão dos Santos and Pflueger, Grete Soares},
  booktitle = {10º Seminário Docomomo Norte/Nordeste, Campina Grande, 2024},
  year      = {2024},
  address   = {Campina Grande, PB},
  isbn      = {978-65-272-1054-2},
  organization = {UFCG, UNIFACISA},
  abstract  = {O presente artigo realiza uma análise da mobilidade urbana na escala de vizinhança em Palmas, capital do estado do Tocantins. Idealizada e fundada no final do século XX, busca-se compreender os reflexos do urbanismo moderno nas diretrizes de seu plano, assim como o uso das diferentes escalas de planejamento em seu traçado, além de propor a identificação do impacto direto na mobilidade urbana de seus habitantes após mais de três décadas de fundação. Para isso, a metodologia foi composta primeiramente por pesquisa bibliográfica e documental, para entender o urbanismo no movimento moderno e sua influência no plano urbanístico de Palmas, bem como o contexto histórico que envolve a fundação da capital tocantinense. A pesquisa empírica se deu por meio de visitas in loco para levantamento fotográfico, observação de edificações institucionais e uma melhor percepção espacial da escala de vizinhança de cada área analisada. Assim, foram escolhidas três unidades de vizinhança localizadas em diferentes pontos do território de Palmas: 204 SUL, 1103 SUL e um recorte do bairro Jardim Aureny I, onde foram utilizados diferentes modais — rodoviário, cicloviário e a pé — para compreender de maneira prática, como os tipos de deslocamento se aplicam ao longo do território. Como resultado de um Trabalho de Conclusão de Curso, este artigo demonstra, por meio de mapas e ilustrações, as consequências atreladas à inserção de diretrizes urbanísticas modernistas na malha urbana da cidade de Palmas.
},
  keywords  = {Movimento Moderno, Mobilidade Urbana, Escala de Vizinhança},
}
