  title     = {Manifestações do Moderno na Bahia: Casa da França},
  author    = {Nery, Juliana Cardoso and Reis, Clara Rachel},
  booktitle = {10º Seminário Docomomo Norte/Nordeste, Campina Grande, 2024},
  year      = {2024},
