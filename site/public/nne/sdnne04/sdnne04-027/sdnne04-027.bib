  title     = {Eldorado Country Club Teresina, Antônio Luiz, 1987: um olhar sobre a obra e a continuidade de critérios modernos},
  author    = {Meneses, Priscila de Oliveira and Marques, Rayla Fernanda de Meneses and Duarte, Thabata Micaela Matos Frota Lemos and Oliveira, Willane Soares},
  booktitle = {4º Seminário Docomomo Norte/Nordeste, Natal, 2012},
