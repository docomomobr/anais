  title     = {Uma análise da concepção positivista de ocupação industrial no espaço geográfico do Amapá},
  author    = {Galiano, L. O.},
  booktitle = {6º Seminário Docomomo Norte/Nordeste, Teresina, 2016},
  year      = {2016},
