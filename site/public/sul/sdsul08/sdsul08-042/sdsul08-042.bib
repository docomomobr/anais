  title     = {Produção escrita como registro projetual: os Cadernos do Centro de Desenvolvimento de Equipamentos Urbanos e Comunitários (1990–1992)},
  author    = {Paschoal, Lígia Gimenes and Sakurai, Tatiana},
  booktitle = {8º Seminário Docomomo Sul, Porto Alegre, 2025},
  year      = {2025},
