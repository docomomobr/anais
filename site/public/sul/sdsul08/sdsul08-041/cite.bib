  title     = {Montadas e largadas: casas individuais pré-fabricadas perdidas na Amazônia},
  author    = {Porto, Cícero Veiga Oliveira},
  booktitle = {8º Seminário Docomomo Sul, Porto Alegre, 2025},
  year      = {2025},
  address   = {Porto Alegre, RS},
