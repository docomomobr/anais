  title     = {Oscar Niemeyer e o edifício Manchete: o arquiteto e o Grupo Bloch},
  author    = {Rossetti, Eduardo Pierrotti and Campos, Bruno Pedro Alves de},
  booktitle = {7º Seminário Docomomo Sul, Porto Alegre, 2022},
  year      = {2022},
  address   = {Porto Alegre, RS},
