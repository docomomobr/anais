  title     = {O passo a passo moderno no Projeto Interpretativo do centro histórico de Santa Maria},
  author    = {Flôres, Anelis Rolão},
  booktitle = {7º Seminário Docomomo Sul, Porto Alegre, 2022},
  year      = {2022},
  address   = {Porto Alegre, RS},
  pages     = {386-394},
