@inproceedings{sdsp08_026,
  title     = {Arquitetura e cidade no processo de modernização: Londrina e sua produção moderna na década de 1950},
  author    = {Fachi, Fernanda Millan and Buzzar, Miguel Antônio},
  booktitle = {8º Seminário Docomomo São Paulo, São Carlos, 2022},
  year      = {2022},
  pages     = {385-399},
  doi       = {10.5281/zenodo.19290009},
  isbn      = {978-65-86810-58-5},
  url       = {https://anais.docomomobrasil.com/se/sdsp08/sdsp08-026/},
  abstract  = {A partir da ideia de cidade enquanto agente modernizador, que utiliza como instrumento o processo de modernização, e o conceito de cidade como fonte e foco de criação cultural, a extensa produção de alta qualidade média da arquitetura brasileira nos anos de 1950 torna-se evidente em diferentes cidades e contextos do cenário nacional. É o caso de Londrina, no norte do Paraná, cuja produção, sobretudo na década de 1950 – em virtude do êxito da cultura cafeeira –, evidencia a dimensão moderna da cidade através de suas obras arquitetônicas concomitantemente ao seu processo de modernização. Diante disso, este trabalho propõe a análise de alguns exemplares da arquitetura moderna em Londrina, entre os anos de 1950: o mercado Shangri-lá, a Estação Rodoviária, o Edifício ECB, o Edifício Autolon e o Edifício Sahão. As obras marcam o panorama da cidade de Londrina e revelam aspectos da modernização da cidade frente à sua formação.},
  keywords  = {Modernização, Cidade, Londrina},
}
