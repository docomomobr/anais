@inproceedings{sdsp05_063,
  title     = {Up-Cycling as Method of Sustainable Transformation: revisiting SESC Pompeia},
  author    = {Lehmann, Steffen},
  booktitle = {5º Seminário Docomomo São Paulo, São Paulo, 2017},
  year      = {2017},
  pages     = {1081-1092},
  isbn      = {978-85-88157-16-3},
  organization = {Núcleo Docomomo São Paulo / Editora Altermarket},
  abstract  = {The most sustainable building is the one that already exists. Modernity and sustainability are closely intertwined in the challenge of creating better places to live and work. There is an opportunity (and duty) to preserve the existing fabric and reuse buildings which have lost their original function or no longer meet today’s increasingly demanding standards. It is estimated that 80 per cent of buildings in existence today globally will still be there in twenty years’ time, therefore it is the physical improvements and adaptive reuse (‘up-cycling’) of our existing buildings and infrastructure that will contribute in delivering the CO2-emission reductions needed. Upgrading the existing building stock is increasingly used as a method to address inefficiencies and a secure way to reduce emissions: by increasing the longevity of derelict unoccupied buildings through adaptive reuse, they become suitable sites for many different types of use.
},
  keywords  = {Adaptive reuse, up-cycling intervention, Lina Bo Bardi, modern heritage},
}
