@inproceedings{sdsp03_016,
  title     = {Duas experiências modernas focando edifício e cidade: IAPI Japurá e IAPC Cidade Jardim},
  author    = {Rubano, Lizete Maria and Yamamoto, Aline Fidalgo and Constantino, André Mazzer and Rocha, Fabio Steiner and Giancoli, Giulliano Pandori and Boucinhas, Hamílcar and Oliveira, Lilian Regina Machado de and Nader, Mario Sérgio and Campagnucci, Simone},
  booktitle = {3º Seminário Docomomo São Paulo, São Paulo, 2005},
