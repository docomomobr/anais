  author    = {Almeida, Eneida de and Imbronito, Maria Isabel and Mattos, Paula de Vicenzo Fidelis Belfort},
  booktitle = {6º Seminário Docomomo São Paulo, São Carlos, 2018},
  year      = {2018},
