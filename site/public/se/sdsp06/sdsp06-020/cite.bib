@inproceedings{sdsp06_020,
  title     = {Casa Ninca Bordano, uma abóbada na rua das Jabuticabeiras},
  author    = {Garcia, Bárbara Cardoso and Heine, Brunna},
  booktitle = {6º Seminário Docomomo São Paulo, São Carlos, 2018},
  year      = {2018},
  pages     = {320-336},
  isbn      = {978-85-66624-25-0},
  organization = {Núcleo Docomomo São Paulo / IAU-USP},
  abstract  = {Este trabalho discorre sobre a casa Ninca Bordano, obra de arquitetura moderna localizada em São Paulo, no bairro Cidade Jardim, na rua das Jabuticabeiras; uma residência em abóbada única. É um projeto de 1968, encomendado a Ronaldo Duschenes por Ninca Bordano, para ela e seu filho, Andreas Pavel, que era amigo do arquiteto. Este artigo aborda o projeto original, os modos de morar em tal residência, o histórico de intervenções e o atual estado de conservação da casa, descrevendo sua condição de arruinamento. É uma casa com características relevantes para o patrimônio edificado moderno de São Paulo, que está sem uso há quase dez anos e atualmente pode ser entendida como uma ruína.
},
  keywords  = {Residência moderna, Arquitetura paulista, Casa em abóbada},
}
