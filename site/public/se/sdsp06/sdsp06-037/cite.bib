@inproceedings{sdsp06_037,
  title     = {Dois edifícios industriais de Gregório Zolko. Os projetos da Amortex (1968) e Belzer (1976)},
  author    = {Oliveira, Ricardo José Rossin de and Vázquez Ramos, Fernando Guillermo},
  booktitle = {6º Seminário Docomomo São Paulo, São Carlos, 2018},
  year      = {2018},
  pages     = {597-610},
  isbn      = {978-85-66624-25-0},
  organization = {Núcleo Docomomo São Paulo / IAU-USP},
  abstract  = {O texto apresenta e analisa dois edifícios industriais, um para a fábrica da Amortex, de 1968, e outro para a Belzer, de 1976, cujos projetos foram desenvolvidos pelo arquiteto Gregório Zolko, em parceria com seu sócio Wolfgang Schoedon, quando formavam o escritório Constructa (1958-2008). Ambos os edifícios industriais foram divulgados por revistas especializadas da época, e se constituíram como referências da produção moderna da arquitetura da década de 1970. A abordagem analítica dos projetos identificou duas propostas diferentes para uma mesma tipologia, que influenciou na hora de desenvolver os projetos, seja na concepção (partido), como nas decisões sobre os materiais utilizados para a construção dos edifícios.
},
  keywords  = {Fábricas, Pré-fabricados, Constructa},
}
