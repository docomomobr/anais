@inproceedings{sdrj03_002,
  title     = {Milton Roberto (1914 — 1953)},
  author    = {Souza, Luiz Felipe Machado Coelho de and Guimaraens, Cêça and Berredo, Hilton and Figueiredo, Guilherme Araújo de},
  booktitle = {3º Encontro Docomomo Rio, Rio de Janeiro, 2014},
  year      = {2014},
  isbn      = {978-85-88341-63-0},
  organization = {UFRJ/FAU/PROARQ},
  abstract  = {Milton Dória Baptista nasceu em 30 de março de 1914 no Rio de Janeiro e diplomou-se arquiteto em 1935 pela Escola Nacional de Belas-Artes. Milton Roberto iniciou sua carreira como auxiliar de Marcelo Roberto, seu irmão mais velho, e com ele participou do concurso de projetos para a sede da ABI em 1935. Após a vitória nesse concurso, o escritório passou a denominar-se MM Roberto Arquitetos. Em 1941, Mauricio foi integrado ao escritório e a equipe passou a denominar-se MMM Roberto. O papel desempenhado por Milton foi sempre o de comandar a sala de desenhos. Sua dedicação à prancheta, reconhecida pela crítica, caracteriza a condição de Milton, maior responsável pelas originalidade da obra do escritório MMM Roberto. Destacam-se no conjunto da obra a sede da Associação Brasileira de Imprensa (1935), o terminal de passageiros e hangares do aeroporto Santos Dumont (1938), a sede do Instituto de Resseguros do Brasil (1941), a Colônia de Férias do IRB (1943), as instalações industriais SOTREC/Carterpillar (1944), o edifício residencial Júlio Barros Barreto (1947), a escola de formação profissional, carpintaria naval, do SENAI (1948), o edifício Seguradoras (1949), o edifício residencial Dona Fátima e Finúsia (1951) e o edifício Marquês do Herval (1952). Além de realizar projetos e obras, Milton foi eleito Presidente do Instituto de Arquitetos do Brasil em 1949, cargo que ocupou até sua morte em 11 de julho de 1953.
},
}
