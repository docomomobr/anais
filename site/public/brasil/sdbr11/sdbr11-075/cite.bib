  title     = {Inventário do Patrimônio Arquitetônico Teresinense: contribuições para preservação da paisagem},
  author    = {Guimarães, Víctor Veríssimo and Melo, Alcília Afonso de Albuquerque e},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
  pages     = {1-11},
  doi       = {10.5281/zenodo.19074681},
