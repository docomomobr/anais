  title     = {Questões de movimento na arte e na arquitetura: interfaces possíveis},
  author    = {Recena, Maria Paula Piazza},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19074721},
