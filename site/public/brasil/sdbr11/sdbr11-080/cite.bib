  title     = {Design de superfície: estudo iconográfico e cultural dos revestimentos e elementos morfológicos da Arquitetura Moderna de Campina Grande, PB},
  author    = {Medeiros, Arthur Thiago Thamay and Melo, Alcília Afonso de Albuquerque e},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19074699},
