  title     = {Natal moderna: o legado de Djalma Maranhão},
  author    = {Nobre, Paulo José Lisboa and Andrade, Caio Cesar Maia de},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
