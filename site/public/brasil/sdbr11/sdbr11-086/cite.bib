  author    = {Paz, Daniel Juracy Mellado},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
  pages     = {1-19},
  doi       = {10.5281/zenodo.19074719},
