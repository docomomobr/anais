  title     = {IPPMG: Obra exemplar, síntese das artes, de Jorge Machado Moreira},
  author    = {Amora, Ana Maria Gadelha Albano and Beck Souza, Eliara},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
