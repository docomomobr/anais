  title     = {As contribuições da pesquisa histórica para a preservação do Patrimônio Edificado: o caso do Hotel Internacional Reis Magos. Natal/RN},
  author    = {Freire Costa, Andréa Virgínia and Cruz, Luana Honório and Regis Pinheiro, Maria Géssica},
  booktitle = {11º Seminário Docomomo Brasil, Recife, 2016},
  year      = {2016},
  address   = {Recife},
