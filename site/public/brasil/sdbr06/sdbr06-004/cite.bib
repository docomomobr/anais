@inproceedings{sdbr06_004,
  title     = {Pernambuco falando para o mundo},
  author    = {Medeiros, Ana Elisabete de Almeida},
  booktitle = {6º Seminário Docomomo Brasil, Niterói, 2005},
  year      = {2005},
  address   = {Niterói},
  doi       = {10.5281/zenodo.19072319},
  isbn      = {85-99618-01-6},
  url       = {https://zenodo.org/records/19072320/files/sdbr06-004.pdf},
  organization = {UFF},
  abstract  = {Em um momento em que a comunidade (inter)nacional reconhece e valoriza, cada vez mais, o caráter memorial do patrimônio modernista, bem como o impacto do Movimento Moderno brasileiro na construção social da prática preservacionista verde e amarela, permitir que Pernambuco fale para o mundo, nas páginas que se seguem, significa buscar uma comprovação dessas afirmações no cenário local. Para tanto, o artigo encontra-se estruturado em três partes. Em “Antecedentes”, procura-se vislumbrar, no contexto recifense, a relação, então antagônica, entre modernidade (desenvolvimento) e preservação. Os primeiros passos no sentido da institucionalização da prática patrimonial, em meio aos contextos histórico, econômico, político, social e cultural nacionais pretendem estabelecer o “Marco Inicial do Diálogo” entre o Estado, a Nação e o mundo. Por fim, “Com a palavra: o 10 Distrito” retorna com maior ênfase ao âmbito local, de modo a demonstrar a força do Movimento Moderno recifense na reprodução da política nacional de salvaguarda, ainda às voltas com o embate entre modernidade e preservação – embate esse que cede lugar a movimentos conciliatórios apenas um pouco mais à frente, com o advento da pósmodernidade.
},
  keywords  = {Patrimônio cultural, Modernismo e Recife},
}
