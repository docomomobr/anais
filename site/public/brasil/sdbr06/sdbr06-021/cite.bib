  title     = {Plástica e Tradição: uma aproximação entre Lucio Costa e Fernando Távora},
  author    = {Noto, Felipe de Souza},
  booktitle = {6º Seminário Docomomo Brasil, Niterói, 2005},
  year      = {2005},
