  title     = {Entre o chão e o céu: as rampas em Artigas},
  author    = {Nobre Rabelo, Clevio Dheivas},
  booktitle = {6º Seminário Docomomo Brasil, Niterói, 2005},
  year      = {2005},
  address   = {Niterói},
