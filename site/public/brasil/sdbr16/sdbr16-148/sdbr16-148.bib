  title     = {Tribunas do moderno: imprensa e Arquitetura no Brasil (1920–1950)},
  author    = {Trajano Filho, Francisco Sales and Gonçalves, Monaliza Cristina},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
