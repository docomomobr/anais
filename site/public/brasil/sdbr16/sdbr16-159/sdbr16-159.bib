  author    = {Andrade, Manuella Marianna and Gomes, Ítalo Monteiro de Oliveira Mariano},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
