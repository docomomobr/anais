  title     = {Residência Kubitscheck: habitar na Pampulha, habitar na modernidade},
  author    = {Carsalade, Flávio de Lemos and Brandão, Mariana Guimarães},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
