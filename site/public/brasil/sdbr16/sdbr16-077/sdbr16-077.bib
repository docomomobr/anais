  title     = {Uma nova sociedade moderna? Dois ícones na Venezuela (1955-1961)},
  author    = {Santos, Ruan Carlos Marques dos and Huapaya Espinoza, José Carlos},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
