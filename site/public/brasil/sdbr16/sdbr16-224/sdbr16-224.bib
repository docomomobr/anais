@inproceedings{sdbr16_224,
  title     = {A poética espaço-tempo nos projetos de concursos de Roberto Loeb},
  author    = {Florio, Wilson},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
  doi       = {10.5281/zenodo.19434598},
  isbn      = {978-65-993024-6-6},
  url       = {https://anais.docomomobrasil.com/brasil/sdbr16/sdbr16-224/},
  abstract  = {Projetos de arquitetura destinados a concursos estimulam a exploração de conceitos, induzindo arquitetos a elaborar propostas inovadoras e transformadoras. O presente artigo tem como foco projetos de concursos não realizados elaborados pelo arquiteto Roberto Loeb. Oscilando entre a utopia e a realidade, ideações especulativas incorporam pesquisa resultante da inquietação em relação a fatos significativos em contextos urbanos. A concepção de projetos demanda criatividade, adoção de conceitos e articulação entre arte e técnica. A fundamentação teórica adotada pela pesquisa entrelaça teorias espaciais para examinar os projetos selecionados, abrangendo desde uma visão estática e intelectual até uma abordagem experiencial e fenomenológica. A originalidade deste artigo reside na análise dos projetos de concursos elaborados pelo arquiteto, fundamentada em conceitos por ele mesmo estabelecidos.},
  keywords  = {Teoria do Espaço, Conceito, Circulação},
}
