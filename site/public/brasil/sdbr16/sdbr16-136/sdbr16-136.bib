  title     = {Edifício João Brícola: uma leitura de documentos seminais},
  author    = {Vasconcelos, Hermógenes Moussallem},
  booktitle = {O Futuro do Passado: Arquitetura Moderna Viva e Urbana},
  year      = {2026},
  address   = {Porto Alegre},
