  title     = {Esplendor, cinzas e ressurgimento: a trajetória do Cine Teatro Ouro Verde},
  author    = {Suzuki, Juliana Harumi},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
