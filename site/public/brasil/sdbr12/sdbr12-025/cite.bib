@inproceedings{sdbr12_025,
  title     = {O patrimônio arquitetônico moderno do Campus Central da Universidade Federal do Rio Grande do Norte: a contribuição brutalista do arquiteto Alcyr Meira},
  author    = {Carvalho, Heliana Lima de and Vieira-de-Araújo, Natália Miranda},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
  address   = {Uberlândia},
  doi       = {10.5281/zenodo.19076940},
