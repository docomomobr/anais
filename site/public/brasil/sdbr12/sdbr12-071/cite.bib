  title     = {Hotel Internacional dos Reis Magos: análise do memorando do DEPAM pelo não tombamento do Hotel},
  author    = {Maia, Monique Graziella de Medeiros Ribeiro},
  booktitle = {12º Seminário Docomomo Brasil, Uberlândia, 2017},
  year      = {2017},
