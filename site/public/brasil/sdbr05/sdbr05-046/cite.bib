  title     = {Edifício do Pavilhão de Óbitos do Recife},
  author    = {Andrade, Paulo Raposo and Câmara, Andréa Nascimento Dornelas and Medina, Luciano Lacerda},
  booktitle = {5º Seminário Docomomo Brasil, São Carlos, 2003},
  year      = {2003},
