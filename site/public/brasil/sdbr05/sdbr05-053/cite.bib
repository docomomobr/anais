@inproceedings{sdbr05_053,
  title     = {Uma arquiteta, duas capitais, dois projetos de museu},
  author    = {Rubino, Silvana Barbosa},
  booktitle = {5º Seminário Docomomo Brasil, São Carlos, 2003},
  year      = {2003},
  address   = {São Carlos},
