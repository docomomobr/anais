  title     = {A organização do fundo do arquiteto Joaquim Guedes: para o estudo da Arquitetura e do Urbanismo Moderno},
  author    = {Sato, Vitor Berge and Uliana, Dina Elisabete and Leme, Maria Cristina da Silva},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
