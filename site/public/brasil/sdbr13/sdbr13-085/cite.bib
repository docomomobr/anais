@inproceedings{sdbr13_085,
  title     = {Holanda Mendonça e a difusão da Arquitetura Moderna Brasileira no Sul},
  author    = {Gonçalves, Magali Nocchi Collares and Abreu Filho, Silvio Belmonte de},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
