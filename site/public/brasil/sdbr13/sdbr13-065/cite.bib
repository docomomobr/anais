  title     = {As estações rodoviárias modernistas no Brasil e o imaginário do 'edifício-cidade'},
  author    = {Pereira, Diogo Augusto Mondini},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1-24},
