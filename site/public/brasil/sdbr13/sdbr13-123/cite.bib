  title     = {Arquitetura de David Léo Bondar: obras das décadas de 1960 e 1970},
  author    = {Barbiero, João Paulo Silveira},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1-28},
  doi       = {10.5281/zenodo.19077698},
