  title     = {Paisagem Cultural, Terra, Água, Fogo e Ar: (Praça do) Cruzeiro em Brasília},
  author    = {Soares, Eduardo Oliveira and Streletcki, Ana Carolina Canuto},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1-19},
  doi       = {10.5281/zenodo.19077324},
