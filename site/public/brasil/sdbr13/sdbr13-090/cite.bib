  title     = {Habitação social na América Latina: os projetos de Germán Samper na Colômbia},
  author    = {Galarz, Fabiane Biedrzycka da Silva and Gonsales, Célia Helena Castro},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
