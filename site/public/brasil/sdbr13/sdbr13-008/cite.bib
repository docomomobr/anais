  title     = {O Teatro da República: história do projeto do Palácio Itamaraty},
  author    = {Brandão, Claudio Roberto Comas and Amora, Ana Maria Gadelha Albano},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1-19},
