  title     = {O papel da associação de críticos de arte no debate arquitetônico da década de 50: uma análise a partir da imprensa brasileira},
  author    = {Baptista, Marianna de Assis Palmeira and Peixoto, Priscilla Alves},
  booktitle = {13º Seminário Docomomo Brasil, Salvador, 2019},
  year      = {2019},
  address   = {Salvador},
  pages     = {1},
