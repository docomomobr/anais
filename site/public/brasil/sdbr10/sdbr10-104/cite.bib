  title     = {O Brutalismo de Régis Cavalcanti},
  author    = {Morais, Fernando de Oliveira and Medeiros, Elis Dantas},
  booktitle = {10º Seminário Docomomo Brasil, Curitiba, 2013},
  year      = {2013},
  address   = {Curitiba},
  pages     = {1-17},
  doi       = {10.5281/zenodo.19074407},
