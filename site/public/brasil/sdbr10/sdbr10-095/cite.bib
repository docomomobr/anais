  title     = {O fórum de Uberlândia: "Brutalismo Paulista" em Minas?},
  author    = {Cappello, Maria Beatriz Camargo and Paiva, Kauê Felipe},
  booktitle = {10º Seminário Docomomo Brasil, Curitiba, 2013},
  year      = {2013},
  address   = {Curitiba},
  pages     = {1-19},
