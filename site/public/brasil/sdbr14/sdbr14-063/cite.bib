@inproceedings{sdbr14_063,
  title     = {Habitação no centro de Brasília: solução ou problema?},
  author    = {Goulart, Maurício Guimarães and Camargo, Laura Ribeiro de Toledo and Santos, Júnio Carvalho},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-18},
  doi       = {10.5281/zenodo.19078133},
