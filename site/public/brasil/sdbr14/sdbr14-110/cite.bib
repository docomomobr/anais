  title     = {Sergio Rodrigues, o SR2 e o mobiliário: diálogos abertos entre arquitetura e design},
  author    = {Ogawa, Wanderson Leão Afonso and Caixeta, Eline Maria Moura Pereira},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
