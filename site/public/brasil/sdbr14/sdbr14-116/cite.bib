@inproceedings{sdbr14_116,
  title     = {Transformações do Ginásio (Palácio dos Esportes) do Clube Athlético Paulistano: obra dos arquitetos Paulo Mendes da Rocha e João Eduardo de Gennaro, 1958-1961 (2020)},
  author    = {Macedo, Ricardo Moraes Mendes and Vázquez Ramos, Fernando Guillermo},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-16},
  doi       = {10.5281/zenodo.19078287},
  isbn      = {978-65-00-40027-4},
  url       = {https://zenodo.org/records/19078288/files/sdbr14-116.pdf},
  organization = {Universidade Federal do Pará, FAU, PPGAU},
  abstract  = {A comunicação trata sobre as transformações que se sucederam no Ginásio do Club Athlético Paulistano, obra de Paulo Mendes da Rocha e João Eduardo de Gennaro, desde a época do projeto (um concurso de ideias promovido pelos dirigentes do clube em 1958) até a atualidade. As transformações mostram não só o impacto do uso e das adaptações necessárias ou impostas que foram executadas pelo clube, sem intervenção dos autores, durante décadas, como também o impacto, geralmente negativo, que as modificações produziram sobre a obra (e sobre os usuários). Apresenta e discute, também, a mudança de atitude das autoridades do clube, após a verificação da reverencia que pela obra, consagrada, e pela figura de seus autores, Paulo Mendes da Rocha, veio consolidando-se nos últimos anos.
},
  keywords  = {Arquitetura Moderna, Brutalismo, Arquitetura Paulista, Pós-ocupação},
}
