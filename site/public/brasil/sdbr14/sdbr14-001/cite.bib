  title     = {Uni-Seco do Brasil: repercussão de pré-fabricação do pós-segunda guerra},
  author    = {Camargo, Mônica Junqueira de and Montenegro Filho, Roberto Alves de Lima},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-15},
  doi       = {10.5281/zenodo.19077892},
