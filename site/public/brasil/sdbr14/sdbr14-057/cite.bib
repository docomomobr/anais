  title     = {Fotografia e representação: José Moscardi e a arquitetura paulista 1950-1970},
  author    = {Fernandes, Luiz Gustavo Sobral},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19078114},
