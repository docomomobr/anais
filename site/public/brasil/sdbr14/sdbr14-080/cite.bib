  title     = {A Móveis Cimo S.A.: a construção da narrativa no contexto do móvel moderno brasileiro},
  author    = {Schwerz, Wesley and Souza, Andre Felipe Batistella and Alves, André Augusto de Almeida},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-18},
  doi       = {10.5281/zenodo.19078179},
