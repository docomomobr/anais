  title     = {Encontros revelados: Marcel Gautherot e Pierre Verger na Revista do Patrimônio},
  author    = {Brandão, Natália Correia and Cunha, Marcio Cotrim},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-17},
