  title     = {Um outro olhar sobre a Arquitetura Moderna: natureza e preservação},
  author    = {Fernandes, Fernanda},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-14},
