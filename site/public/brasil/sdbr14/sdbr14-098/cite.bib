  author    = {Ecker, Vivian Dall'Igna},
  booktitle = {14º Seminário Docomomo Brasil, Belém, 2021},
  year      = {2021},
  address   = {Belém},
  pages     = {1-15},
  doi       = {10.5281/zenodo.19078227},
