@inproceedings{sdbr09_050,
  title     = {Patrimônio ambiental urbano: revendo conceitos},
  author    = {Lustoza, Regina Esteves},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
  pages     = {1-19},
  doi       = {10.5281/zenodo.19073710},
  isbn      = {978-85-60762-04-0},
  url       = {https://zenodo.org/records/19073711/files/sdbr09-050.pdf},
  organization = {PPG-FAU-UnB},
  abstract  = {Por meio do processo de evolução do conceito de patrimônio ambiental urbano, tomando por base os paradigmas internacionais expressos nos documentos do ICOMOS e governo federal e estadual. Apontam-se possibilidades e desafios da preservação do patrimônio ambiental urbano moderno. Na perspectiva de contribuir para a compreensão do meio ambiente e do desenvolvimento humano, o artigo procura discutir o conceito de valor da natureza no âmbito da abordagem da conservação integrada e do patrimônio ambiental urbano. Os valores da natureza pregados pela Carta se inserem em uma visão, que permite uma larga interpretação baseada no respeito e no reconhecimento do valor de existência dos recursos naturais e dos princípios de solidariedade e preservação da diversidade cultural. As novas interpretações dadas ao meio ambiente, enquanto patrimônio pertencente a todos os povos da Terra, partem do princípio dos valores intrínsecos ao seu suporte biológico e geofísico e sua relação com o desenvolvimento humano.
},
  keywords  = {patrimônio ambiental urbano, patrimônio cultural, patrimônio natural},
}
