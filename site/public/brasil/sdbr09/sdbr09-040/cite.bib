  title     = {Patrimônio e mídia interativa: as residências modernas na Serra Gaúcha — Brasil},
  author    = {Stumpp, Monika Maria and Radünz, Roberto and Costa, Ana Elísia da},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
  pages     = {1-10},
