  title     = {Capacitação em conservação da Arquitetura Moderna: a experiência do CECI e do MDU-UFPE},
  author    = {Moreira, Fernando Diniz and Amorim, Luiz Manuel do Eirado},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
