@inproceedings{sdbr09_015,
  title     = {Palácio Farroupilha: uma reflexão sobre a monumentalidade moderna},
  author    = {Machado, Andréa Soler},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
  address   = {Brasília},
