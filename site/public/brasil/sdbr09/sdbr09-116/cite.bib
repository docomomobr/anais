  title     = {Plano de Conservação: Jardim de Infância Ana Rosa Falcão de Carvalho},
  author    = {Brasileiro, Carolina and Alecrim, Laura Nobre and Nóbrega, Lívia Morais and Pinto, Fernanda Lúcia Herbster and Siqueira, Raphaela Banks de},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
