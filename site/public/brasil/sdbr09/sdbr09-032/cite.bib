  title     = {Cultura disciplinar e arquivos de arquitetura: Gio Ponti e o Brasil},
  author    = {Ponzio, Angelica Paiva},
  booktitle = {9º Seminário Docomomo Brasil, Brasília, 2011},
  year      = {2011},
