  title     = {Apropriação dos símbolos modernistas: representação do Palácio da Alvorada (1958) em cédulas produzidas durante o regime militar (1964-1988)},
  author    = {Drumond Almeida, Pedro Paulo},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
