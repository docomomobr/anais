  title     = {Estado, símbolo, nação: a construção da singularidade na Arquitetura Moderna Brasileira dos anos 1930},
  author    = {Franco, Felipe Henrique},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19069718},
