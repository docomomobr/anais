  title     = {A renovação urbana e a preservação urbana: os conceitos no contexto do planejamento urbano de Curitiba (1950-1990)},
  author    = {Castro, Brenda Lais de},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-11},
  doi       = {10.5281/zenodo.19069790},
