  title     = {Habitação social na paisagem do Rio de Janeiro do século XX: uma análise a partir da morfologia urbana},
  author    = {Sagaz, Natália},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-15},
