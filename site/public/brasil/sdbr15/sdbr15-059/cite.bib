  title     = {Habitação vertical no Rio de Janeiro: ensaio sobre as primeiras diretrizes modernas},
  author    = {Cabral, Maria Cristina Nascentes and Nunes, Denise Vianna and Bastos, Aline Gago Lorenzini},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-12},
  doi       = {10.29327/1344945.1-15},
