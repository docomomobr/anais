  title     = {A monumentalidade em Islamabad, Paquistão a partir de estratégias projetuais encontradas em Brasília, Brasil},
  author    = {Lopes, Bruna and Saboia, Luciana},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-11},
  doi       = {10.5281/zenodo.19069598},
