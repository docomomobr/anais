  title     = {Origem e desdobramentos do desenvolvimentismo no Brasil: o poder estatal no processo de urbanização do oeste paulista},
  author    = {Sampaio, Inayara Santos},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-15},
