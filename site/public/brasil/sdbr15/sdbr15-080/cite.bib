  title     = {O Auditório "Oscar Niemeyer" da cidade de Ravello: trajetória de uma ideia},
  author    = {Schettino, Leopoldo and Perrone, Rafael Antonio Cunha},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-14},
  doi       = {10.29327/1344945.1-6},
