  title     = {As teorias do espaço e a Arquitetura Moderna: escritos de Schindler e Moholy-Nagy},
  author    = {Rocha, Mércia Parente},
  booktitle = {15º Seminário Docomomo Brasil, São Carlos, 2023},
  year      = {2023},
  address   = {São Carlos, SP},
  pages     = {1-12},
  doi       = {10.5281/zenodo.19069569},
