@inproceedings{sdbr08_007,
  title     = {Avenida Conselheiro Nébias: prenúncio de Modernidade em Santos},
  author    = {Maziviero, Maria Carolina},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
  address   = {Rio de Janeiro},
  pages     = {1-15},
  doi       = {10.5281/zenodo.19072790},
  isbn      = {978-85-88027-11-4},
