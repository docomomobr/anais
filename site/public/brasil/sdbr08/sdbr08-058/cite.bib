@inproceedings{sdbr08_058,
  title     = {A universidade e a cidade: por uma história da Arquitetura Moderna da Universidade Federal do Ceará},
  author    = {Jucá Neto, Clóvis Ramiro and Fernandes, Ricardo and Nascimento, José Clewton do and Andrade, Margarida Júlia Farias de Salles and Diógenes, Beatriz Helena Bezerra Nogueira},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
