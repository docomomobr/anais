  title     = {De volta para o futuro: projeto antigo, patrimônio novo},
  author    = {Pellegrini, Ana Carolina Santos},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
