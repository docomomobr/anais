@inproceedings{sdbr08_071,
  title     = {Brasília e o Tombamento: patrimônio e especulação na cidade modernista},
  author    = {Santos, Marcos Antonio dos},
  booktitle = {8º Seminário Docomomo Brasil, Rio de Janeiro, 2009},
  year      = {2009},
